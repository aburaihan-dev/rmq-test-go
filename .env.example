# RabbitMQ settings for rmq-go. Copy this file to .env and edit.
# The vhost must already exist and the user needs permissions on it
# (guest/guest only works from localhost, and only on the "/" vhost by default).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=demo
RABBITMQ_QUEUE=demo.queue
# Optional: quorum (default) or classic. A queue's type can't change once it exists,
# so use a new queue name when you switch.
RABBITMQ_QUEUE_TYPE=quorum
