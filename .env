# RabbitMQ settings for rmq-go (local defaults copied from .env.example; edit for your broker).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=demo
RABBITMQ_QUEUE=demo.quorum
# quorum (default) or classic; the type of an existing queue can't change.
RABBITMQ_QUEUE_TYPE=quorum
